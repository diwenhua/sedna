# Optional bootstrap only; prefer Settings → Web Search for provider and API keys.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Web tools (search + fetch). Provider: brave | bailian | searxng | duckduckgo
WEB_TOOLS_ENABLED=true
WEB_SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
DASHSCOPE_API_KEY=
SEARXNG_URL=
WEB_SEARCH_MAX_RESULTS=5
WEB_FETCH_MAX_CHARS=8000
WEB_FETCH_TIMEOUT_MS=15000
